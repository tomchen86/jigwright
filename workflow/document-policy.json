{
  "schemaVersion": 1,
  "enforcementMode": "enforced",
  "documents": {
    "docs/ROADMAP.md": {
      "mode": "curated"
    },
    "docs/CURRENT_AND_NEXT_STEPS.md": {
      "mode": "generated",
      "enforcement": "active",
      "source": "openspec/changes/*/tasks.md",
      "validator": "managed-documents",
      "transition": "completion"
    },
    "docs/BACKLOG.md": {
      "mode": "generated",
      "enforcement": "planned",
      "source": "docs/work-registry/items/**",
      "validator": "work-registry"
    },
    "docs/work-registry/inventory.json": {
      "mode": "generated",
      "enforcement": "planned",
      "source": "docs/work-registry/items/**",
      "validator": "work-registry"
    },
    "docs/work-registry/items/**": {
      "mode": "curated",
      "enforcement": "planned"
    },
    "docs/work-history/**": {
      "mode": "generated",
      "enforcement": "planned",
      "source": "docs/work-registry/items/**",
      "validator": "work-registry"
    },
    "docs/WORKFLOW.md": {
      "mode": "curated",
      "enforcement": "planned"
    },
    "docs/CHANGELOG.md": {
      "mode": "append-only",
      "enforcement": "planned"
    },
    "docs/architecture/**": {
      "mode": "curated",
      "refresh": "reviewed-section"
    },
    "docs/features/**": {
      "mode": "curated",
      "refresh": "reviewed-section"
    },
    "docs/research/**": {
      "mode": "reference"
    },
    "docs/archive/**": {
      "mode": "immutable",
      "enforcement": "planned"
    },
    "openspec/changes/**": {
      "mode": "change-artifact"
    },
    ".agents/skills/spectra-*/**": {
      "mode": "reference"
    },
    "packages/workflow-engine/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/adoption/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/assurance/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/authority/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/governance-intake/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/guidance/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/investigation/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/lifecycle/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/projection/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/provider-orchestration/spec.md": {
      "mode": "normative"
    },
    "packages/workflow-engine/src/modules/source/spec.md": {
      "mode": "normative"
    },
    "spec.md": {
      "mode": "normative"
    }
  }
}
