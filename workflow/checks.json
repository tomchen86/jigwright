{
  "schemaVersion": 1,
  "checks": {
    "workflow-typecheck": {
      "command": [
        "node-package-bin",
        ".",
        "typescript",
        "tsc",
        "-p",
        "packages/workflow-engine/tsconfig.json"
      ],
      "destructiveDatabase": false
    },
    "workflow-tests": {
      "command": [
        "node",
        "--experimental-strip-types",
        "--test",
        "--test-concurrency=4",
        "packages/workflow-engine/test/shards/shard-01.ts",
        "packages/workflow-engine/test/shards/shard-02.ts",
        "packages/workflow-engine/test/shards/shard-03.ts",
        "packages/workflow-engine/test/shards/shard-04.ts",
        "packages/workflow-engine/test/shards/shard-05.ts",
        "packages/workflow-engine/test/shards/shard-06.ts",
        "packages/workflow-engine/test/shards/shard-07.ts",
        "packages/workflow-engine/test/shards/shard-08.ts"
      ],
      "destructiveDatabase": false
    },
    "workflow-full-gate": {
      "command": [
        "node",
        "--experimental-strip-types",
        "scripts/workflow-full-gate.ts"
      ],
      "destructiveDatabase": false,
      "liveStderr": true
    },
    "workflow-lint": {
      "command": [
        "node-package-bin",
        ".",
        "eslint",
        "eslint",
        "packages/workflow-engine/src",
        "packages/workflow-engine/test"
      ],
      "destructiveDatabase": false
    },
    "managed-documents": {
      "command": [
        "node",
        "packages/workflow-engine/src/entrypoints/ci/managed-documents.ts"
      ],
      "destructiveDatabase": false
    },
    "workflow-format": {
      "command": [
        "node-package-bin",
        ".",
        "prettier",
        "prettier",
        "--check",
        "--ignore-unknown",
        "packages/workflow-engine",
        "workflow/ai-adapter-policy.json",
        "workflow/checks.json",
        "workflow/config.json",
        "workflow/document-policy.json",
        "workflow/maintainer-policy.json",
        "workflow/path-roles.json",
        "workflow/schemas",
        "scripts/check-openspec.mjs",
        "openspec/config.yaml",
        "package.json",
        "pnpm-workspace.yaml",
        "AGENTS.md",
        "README.md",
        "docs/README.md",
        "docs/WORKFLOW.md",
        "docs/ROADMAP.md",
        "docs/architecture/ARCHITECTURE.md",
        ".github/CODEOWNERS",
        ".github/workflows/format.yml",
        ".github/workflows/workflow-assurance.yml",
        "prettier.config.cjs"
      ],
      "destructiveDatabase": false
    },
    "openspec-assets": {
      "command": [
        "node",
        "packages/workflow-engine/src/adapters/planning/openspec/documents/openspec-planning-assets.ts"
      ],
      "destructiveDatabase": false
    },
    "openspec-specs": {
      "command": ["node", "scripts/check-openspec.mjs"],
      "destructiveDatabase": false
    }
  }
}
